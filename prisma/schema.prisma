datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["rhel-openssl-1.0.x"]
}

model User {
  conversation   Conversation? @relation(name: "UserConversation")
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  telegramId     Int           @unique
  books          Book[]        @relation(name: "BooksUserCanAccess")
  bookSelected   Book?         @relation(name: "BookSelectedByUser", fields: [bookSelectedId], references: [id])
  bookSelectedId String?
}

model Book {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  title          String
  lockKey        String?
  timezone       String
  user           User[]         @relation(name: "BooksUserCanAccess")
  selectedByUser User[]         @relation(name: "BookSelectedByUser")
  account        Account[]      @relation(name: "AccountInBook")
  categories     Category[]     @relation(name: "CategoryInBook")
  exchangeRate   ExchangeRate[] @relation(name: "ExchangeRateInBook")
  groupChats     GroupChat[]    @relation(name: "BooksGroupChatGetNotified")
}

model Account {
  conversation Conversation[] @relation(name: "AccountSelectedInConversation")
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  description  String
  notes        String?
  showBalance  Boolean        @default(false)
  balance      Balance[]      @relation(name: "AccountWithBalance")
  transaction  Transaction[]  @relation(name: "TransactionWithAccount")
  book         Book           @relation(name: "AccountInBook", fields: [bookId], references: [id])
  bookId       String
  files        File[]         @relation(name: "AccountWithFile")
}

model Category {
  conversation Conversation[] @relation(name: "CategorySelectedInConversation")
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  description  String
  type         CategoryType   @default(LIMITLESS)
  notes        String?
  transaction  Transaction[]  @relation(name: "TransactionWithCategory")
  bookId       String
  book         Book           @relation(name: "CategoryInBook", fields: [bookId], references: [id])
  files        File[]         @relation(name: "CategoryWithFile")
  limits       Limit[]        @relation(name: "CategoryWithLimit")
}

model Limit {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  ignoreInSummary    Boolean  @default(false)
  validFromYearMonth Int
  amount             Int
  currency           String
  categoryId         String
  category           Category @relation(name: "CategoryWithLimit", fields: [categoryId], references: [id])
}

model ExchangeRate {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  from               String
  to                 String
  amount             Float
  validFromYearMonth Int
  book               Book     @relation(name: "ExchangeRateInBook", fields: [bookId], references: [id])
  bookId             String
}

model Transaction {
  conversation       Conversation[]      @relation(name: "TransactionSelectedInConversation")
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  description        String
  amount             Int
  currency           String
  type               TransactionType     @default(EXPENSE)
  account            Account             @relation(name: "TransactionWithAccount", fields: [accountId], references: [id])
  accountId          String
  category           Category?           @relation(name: "TransactionWithCategory", fields: [categoryId], references: [id])
  categoryId         String?
  groupNotifications GroupNotification[] @relation(name: "TransactionsWithGroupNotification")
  tags               Tag[]               @relation(name: "TransactionWithTag")
  files              File?               @relation(name: "TransactionWithFile", fields: [filesId], references: [id])
  filesId            String?             @unique
}

model GroupNotification {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  groupId       Int
  messageId     String
  transaction   Transaction @relation(name: "TransactionsWithGroupNotification", fields: [transactionId], references: [id])
  transactionId String
}

model Balance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  currency  String
  amount    Int
  account   Account  @relation(name: "AccountWithBalance", fields: [accountId], references: [id])
  accountId String
}

model GroupChat {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  telegramId Int      @unique
  books      Book[]   @relation(name: "BooksGroupChatGetNotified")
}

model File {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  fileId      String       @unique
  fileType    FileType
  transaction Transaction? @relation(name: "TransactionWithFile")
  accountId   String?
  account     Account?     @relation(name: "AccountWithFile", fields: [accountId], references: [id])
  categoryId  String?
  category    Category?    @relation(name: "CategoryWithFile", fields: [categoryId], references: [id])
}

model Tag {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  item          String
  transactionId String
  transaction   Transaction @relation(name: "TransactionWithTag", fields: [transactionId], references: [id])
}

model Conversation {
  id                    String       @id @default(cuid())
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  transactionSelected   Transaction? @relation(name: "TransactionSelectedInConversation", fields: [transactionSelectedId], references: [id])
  transactionSelectedId String?
  accountSelected       Account?     @relation(name: "AccountSelectedInConversation", fields: [accountSelectedId], references: [id])
  accountSelectedId     String?
  categorySelected      Category?    @relation(name: "CategorySelectedInConversation", fields: [categorySelectedId], references: [id])
  categorySelectedId    String?
  user                  User         @relation(name: "UserConversation", fields: [userId], references: [id])
  subject               String
  userId                String       @unique
}

enum CategoryType {
  PAYMENT
  LIMITLESS
  LIMIT
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum FileType {
  PHOTO
  DOCUMENT
}
