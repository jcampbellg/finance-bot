datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["rhel-openssl-1.0.x"]
}

model User {
  conversation   Conversation @relation(name: "UserConversation", fields: [conversationId], references: [id])
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  telegramId     Int          @unique
  booksAccess    Share[]      @relation(name: "UserToRole")
  timezone       String
  conversationId String       @unique
  booksOwn       Book[]       @relation(name: "UserToBook")
  bookSelected   Book?        @relation(name: "BookSelectedByUser", fields: [bookSelectedId], references: [id])
  bookSelectedId String?
}

model Book {
  owner          User           @relation(name: "UserToBook", fields: [ownerId], references: [id])
  ownerId        String
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  title          String
  lockKey        String?
  selectedByUser User[]         @relation(name: "BookSelectedByUser")
  account        Account[]      @relation(name: "AccountInBook")
  categories     Category[]     @relation(name: "CategoryInBook")
  exchangeRate   ExchangeRate[] @relation(name: "ExchangeRateInBook")
  shares         Share[]        @relation(name: "BookToRole")
  groupChats     GroupChat[]    @relation(name: "BooksGroupChatGetNotified")
  budgetRules    BudgetRule[]   @relation(name: "BookToBudget")
}

model Account {
  currency    Currency[]    @relation(name: "CurrencyInAccount")
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  description String
  notes       String?
  transaction Transaction[] @relation(name: "TransactionWithAccount")
  book        Book          @relation(name: "AccountInBook", fields: [bookId], references: [id])
  bookId      String
  files       File[]        @relation(name: "AccountWithFile")
}

model Category {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  description String
  type        CategoryType  @default(TRANSACTION)
  notes       String?
  transaction Transaction[] @relation(name: "TransactionWithCategory")
  bookId      String
  book        Book          @relation(name: "CategoryInBook", fields: [bookId], references: [id])
  files       File[]        @relation(name: "CategoryWithFile")
  payment     Payment[]     @relation(name: "CategoryToPayment")
  split       Split?        @relation(name: "CategoryToSplit")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  from      String
  to        String
  amount    Float
  validFrom Int
  book      Book     @relation(name: "ExchangeRateInBook", fields: [bookId], references: [id])
  bookId    String
}

model Transaction {
  splits             Split[]             @relation(name: "splitToTransaction")
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  description        String
  amount             Float
  currency           String
  type               TransactionType     @default(EXPENSE)
  account            Account             @relation(name: "TransactionWithAccount", fields: [accountId], references: [id])
  accountId          String
  category           Category?           @relation(name: "TransactionWithCategory", fields: [categoryId], references: [id])
  categoryId         String?
  groupNotifications GroupNotification[] @relation(name: "TransactionsWithGroupNotification")
  items              Item[]              @relation(name: "TransactionWithTag")
  files              File[]              @relation(name: "TransactionWithFile")
  paidAt             DateTime?
  tags               String[]
  transferA          Transaction?        @relation(name: "TransactionToTransaction")
  transferB          Transaction?        @relation(name: "TransactionToTransaction", fields: [transferId], references: [id])
  transferId         String?             @unique
  paidDue            DateTime?
}

model GroupNotification {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  groupId       Int
  messageId     Int
  transaction   Transaction @relation(name: "TransactionsWithGroupNotification", fields: [transactionId], references: [id])
  transactionId String
}

model Balance {
  currency    Currency        @relation(name: "AccountWithBalance", fields: [currencyId], references: [id])
  currencyId  String
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  amount      Float
  type        TransactionType
  isUserInput Boolean         @default(false)
}

model GroupChat {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  telegramId Int      @unique
  books      Book[]   @relation(name: "BooksGroupChatGetNotified")
}

model File {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  fileId        String       @unique
  fileType      FileType
  transaction   Transaction? @relation(name: "TransactionWithFile", fields: [transactionId], references: [id])
  accountId     String?
  account       Account?     @relation(name: "AccountWithFile", fields: [accountId], references: [id])
  categoryId    String?
  category      Category?    @relation(name: "CategoryWithFile", fields: [categoryId], references: [id])
  transactionId String?
}

model Item {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  description   String
  transactionId String
  transaction   Transaction @relation(name: "TransactionWithTag", fields: [transactionId], references: [id])
  price         Float?
}

model Conversation {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(name: "UserConversation")
  subject    String
  subSubject String
  messageId  Int?
  edit       Json?
}

model Share {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(name: "UserToRole", fields: [userId], references: [id])
  userId    String
  book      Book     @relation(name: "BookToRole", fields: [bookId], references: [id])
  bookId    String
}

model Currency {
  balance   Balance[] @relation(name: "AccountWithBalance")
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  account   Account   @relation(name: "CurrencyInAccount", fields: [accountId], references: [id])
  accountId String
  symbol    String
}

model BudgetRule {
  book        Book     @relation(name: "BookToBudget", fields: [bookId], references: [id])
  bookId      String
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String
  limit       Limit[]  @relation(name: "BudgetTagToLimit")
  hasLimit    Boolean  @default(false)
  rules       Json[]
}

model Limit {
  budget    BudgetRule @relation(name: "BudgetTagToLimit", fields: [budgetId], references: [id])
  budgetId  String
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  amount    Float
  currency  String
  validFrom Int
}

model Payment {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  amount     Float
  currency   String
  category   Category @relation(name: "CategoryToPayment", fields: [categoryId], references: [id])
  categoryId String
  validFrom  Int
  dueDate    Int?
}

model Split {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  subAmount     Float
  description   String
  transactionId String
  transaction   Transaction @relation(name: "splitToTransaction", fields: [transactionId], references: [id])
  category      Category    @relation(name: "CategoryToSplit", fields: [categoryId], references: [id])
  categoryId    String      @unique
}

enum CategoryType {
  PAYMENT
  TRANSACTION
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum FileType {
  PHOTO
  DOCUMENT
}
