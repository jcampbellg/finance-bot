generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Income {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  conversation   Conversation @relation(name: "UserConversation", fields: [conversationId], references: [id])
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  telegramId     BigInt       @unique
  booksAccess    Share[]      @relation(name: "UserToRole")
  timezone       String
  conversationId String       @unique
  booksOwn       Book[]       @relation(name: "UserToBook")
  bookSelected   Book?        @relation(name: "BookSelectedByUser", fields: [bookSelectedId], references: [id])
  bookSelectedId String?
  otp            Otp?         @relation(name: "UserToOtp")
}

model Book {
  owner          User        @relation(name: "UserToBook", fields: [ownerId], references: [id])
  ownerId        String
  id             String      @id @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  title          String
  lockKey        String?
  selectedByUser User[]      @relation(name: "BookSelectedByUser")
  account        Account[]   @relation(name: "AccountInBook")
  categories     Category[]  @relation(name: "CategoryInBook")
  shares         Share[]     @relation(name: "BookToRole")
  groupChats     GroupChat[] @relation(name: "BooksGroupChatGetNotified")
}

model Account {
  currency     Currency[]    @relation(name: "CurrencyInAccount")
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  description  String
  search       String        @default("")
  transactions Transaction[] @relation(name: "TransactionWithAccount")
  book         Book          @relation(name: "AccountInBook", fields: [bookId], references: [id])
  bookId       String
}

model Category {
  id           String           @id @default(cuid())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  description  String
  search       String           @default("")
  transactions Transaction[]    @relation(name: "TransactionWithCategory")
  bookId       String
  book         Book             @relation(name: "CategoryInBook", fields: [bookId], references: [id])
  type         CategoryType     @default(CATEGORY)
  limits       AmountCurrency[] @relation(name: "CategoryToPayment")
}

model Transaction {
  type               TransactionType     @default(EXPENSE)
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  description        String
  search             String              @default("")
  amount             Float
  currency           String
  account            Account             @relation(name: "TransactionWithAccount", fields: [accountId], references: [id])
  accountId          String
  groupNotifications GroupNotification[] @relation(name: "TransactionsWithGroupNotification")
  paidAt             DateTime?           @default(now())
  tags               String[]
  tagsSearch         String[]
  category           Category?           @relation(name: "TransactionWithCategory", fields: [categoryId], references: [id])
  categoryId         String?
  files              File[]              @relation(name: "TransactionWithFile")
  transferIn         Transfer?           @relation(name: "TransferOut")
  transferOut        Transfer?           @relation(name: "TransferIn")
  splits             Split?              @relation(name: "SplitParents")
  splitId            String?
  parentSplit        Split?              @relation(name: "SplitChildrens", fields: [splitId], references: [id])
}

model GroupNotification {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  groupId       BigInt
  messageId     Int
  transaction   Transaction @relation(name: "TransactionsWithGroupNotification", fields: [transactionId], references: [id])
  transactionId String
}

model GroupChat {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  telegramId BigInt   @unique
  books      Book[]   @relation(name: "BooksGroupChatGetNotified")
}

model File {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  fileId        String
  transaction   Transaction? @relation(name: "TransactionWithFile", fields: [transactionId], references: [id])
  transactionId String?
  fileType      FileType
  items         Item[]       @relation(name: "ItemToFile")
}

model Item {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String
  search      String   @default("")
  fileId      String?
  file        File?    @relation(name: "ItemToFile", fields: [fileId], references: [id])
}

model Conversation {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(name: "UserConversation")
  subject    String
  subSubject String
  messageId  Int?
  edit       Json?
}

model Share {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(name: "UserToRole", fields: [userId], references: [id])
  userId    String
  book      Book     @relation(name: "BookToRole", fields: [bookId], references: [id])
  bookId    String
}

model Currency {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account  @relation(name: "CurrencyInAccount", fields: [accountId], references: [id])
  accountId String
  symbol    String
  balance   Float    @default(0)
}

model AmountCurrency {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  amount     Float
  currency   String
  category   Category @relation(name: "CategoryToPayment", fields: [categoryId], references: [id])
  categoryId String
}

model Transfer {
  id               String       @id @default(cuid())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  out              Transaction? @relation(name: "TransferOut", fields: [transactionOutId], references: [id])
  transactionOutId String?      @unique
  in               Transaction? @relation(name: "TransferIn", fields: [transactionInId], references: [id])
  transactionInId  String?      @unique
}

model Split {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  parent    Transaction   @relation(name: "SplitParents", fields: [parentId], references: [id])
  parentId  String        @unique
  childrens Transaction[] @relation(name: "SplitChildrens")
}

model Otp {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  code      String
  user      User     @relation(name: "UserToOtp", fields: [userId], references: [id])
  userId    String   @unique
}

enum CategoryType {
  PAYMENT
  CATEGORY
  INCOME
}

enum TransactionType {
  EXPENSE
  DEPOSIT
  INCOME
  PAYMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum FileType {
  PHOTO
  DOCUMENT
}
